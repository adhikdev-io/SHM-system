#!/bin/bash
# SHM Exhibition launcher -- binds Bluetooth SPP port if needed, then opens the dashboard
set -e

MAC="08:F9:E0:D5:1F:B2"

# 1. Bind /dev/rfcomm0 (survives nothing -- re-create if missing after reboot)
if [ ! -e /dev/rfcomm0 ]; then
    echo "[SHM] Binding Bluetooth serial port..."
    sudo rfcomm bind rfcomm0 "$MAC"
fi

# 2. Make sure the ESP32 is paired/trusted (instant if already done)
if ! bluetoothctl info "$MAC" 2>/dev/null | grep -q "Trusted: yes"; then
    echo "[SHM] Pairing ESP32..."
    bluetoothctl --timeout 10 scan on >/dev/null 2>&1
    bluetoothctl pair "$MAC" && bluetoothctl trust "$MAC"
fi

echo "[SHM] Starting dashboard..."
cd "$HOME/Documents/shm_system/command_center"
exec .venv/bin/python shm_dashboard.py
